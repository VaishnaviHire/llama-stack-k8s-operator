# Build the ogx-module manager binary.
FROM registry.redhat.io/ubi9/go-toolset:1.26@sha256:c2bd0309bf78ae317024fdfc5602a31704e0dba9572f6d4b0bd4b681033dc965 AS builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG CGO_ENABLED=1

USER root
WORKDIR /workspace/ogx-module

# Copy module dependencies first for better layer reuse.
COPY ogx-module/go.mod go.mod
COPY ogx-module/go.sum go.sum
RUN go mod download

# Copy only the module-local code needed for the manager binary.
COPY ogx-module/cmd/ cmd/
COPY ogx-module/internal/ internal/
COPY ogx-module/pkg/ pkg/

# Build the manager binary.
RUN CGO_ENABLED=${CGO_ENABLED} GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -a -o /workspace/bin/manager ./cmd/ogx-module

# Runtime
FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:c7fdcf2617a608d07f95fa01d8936fc8bf898096a60e5ebc432aae8ead50ea6c
WORKDIR /

COPY --from=builder /workspace/bin/manager .
COPY config/ /manifests/ogx/

USER 1001

ENTRYPOINT ["/manager"]

LABEL com.redhat.component="odh-ogx-module-container" \
      description="OGX Module controller that manages OGX operator deployment and lifecycle" \
      summary="OGX Module controller that manages OGX operator deployment and lifecycle" \
      name="rhoai/odh-ogx-module-operator-rhel9" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-ogx-module-operator" \
      io.k8s.description="odh-ogx-module-operator" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
